# PostgreSQL Configuration
DB_URL=jdbc:postgresql://localhost:5432/skillsphere
DB_USERNAME=postgres
DB_PASSWORD=password

# Eureka Configuration
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_PREFER_IP=true
EUREKA_HOSTNAME=localhost

# Kafka Configuration (Apache Kafka / Upstash)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=
